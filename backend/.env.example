# Database Settings (Local SQLite or Supabase PostgreSQL)
# For Supabase PostgreSQL, set DATABASE_URL to your Supabase Connection String (Transaction Pooler or Direct)
# Example: postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./student_compass.db

# JWT Security Settings
SECRET_KEY=student_life_compass_super_secret_jwt_key_2026_antigravity
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Google Gemini AI Settings
# Get your free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project Credentials (Optional for Supabase Client SDK / Auth)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# CORS origins for frontend deployment. Use a comma-separated list OR a JSON array.
# Example: http://localhost:3000,https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
