# ============================================================
# Student Life Compass — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.
# ============================================================

# Database
DATABASE_URL=sqlite:///./student_compass.db

# JWT Authentication
SECRET_KEY=your_strong_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Google Gemini AI
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# Email Verification API (optional — strongly recommended)
# ============================================================
# Validates that email addresses are real and deliverable at registration.
# Without this only syntax + known-typo-domain checks are applied.
#
# Option 1 — AbstractAPI (free tier: 100 req/month)
#   Sign up at: https://app.abstractapi.com/api/email-validation
#   API URL:    https://emailvalidation.abstractapi.com/v1/
#
# Option 2 — ZeroBounce (free trial available)
#   Sign up at: https://www.zerobounce.net
#   API URL:    https://api.zerobounce.net/v2/validate
#
EMAIL_VERIFICATION_API_URL=
EMAIL_VERIFICATION_API_KEY=

# CORS (adjust for your deployment)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
