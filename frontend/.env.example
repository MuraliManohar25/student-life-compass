# Supabase Configuration (REQUIRED)
# Get these from your Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# VITE_API_BASE_URL: Full URL of the FastAPI backend's /api router.
# Confirmed live backend: https://student-life-compass.onrender.com
VITE_API_BASE_URL=https://student-life-compass.onrender.com/api
VITE_API_URL=http://localhost:8000

# OpenRouteService API Key for maps/routing (Optional)
VITE_ORS_API_KEY=your_ors_api_key_here